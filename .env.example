# Kopie nach .env (steht in .gitignore) und anpassen. Nichts davon wird zur Laufzeit der Seite gebraucht.

# Pfad zum lokalen Spielclient (Forever), nur für scripts/extract-maps.mjs (Etappe W3, Kartenkunst auslesen).
# Beispiel: WOW_FOREVER_DIR=D:\World of Warcraft   (WoW-Ordner mit Data\; der Unterordner _forever_ geht auch)
WOW_FOREVER_DIR=

# Pfad zum Addon-Repo EveN_ForeverChronicle, nur für scripts/sync-core.mjs.
# Leer = Nachbarordner ../EveN_ForeverChronicle.
CHRONICLE_REPO=
